# Copy this file to .env if you want to override the default local paths.
# All values are optional. Use absolute paths.

# Where SQLite, images, attachments, PDFs, audio, and backups live.
# Default: backend/data
# WORKBENCH_DATA=C:\Users\you\WorkbenchData

# Explicit database path (default: %WORKBENCH_DATA%\workbench.db)
# WORKBENCH_DB=C:\Users\you\WorkbenchData\workbench.db

# Where the daily-paper feature stores downloaded PDFs.
# Default: <repo>/daily_paper
# WORKBENCH_DAILY_PAPER_DIR=C:\Users\you\WorkbenchData\daily_paper
